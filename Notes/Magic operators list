ARITHMETIC
────────────────────────────────
+       → __add__()
-       → __sub__()
*       → __mul__()
/       → __truediv__()
//      → __floordiv__()
%       → __mod__()
**      → __pow__()
@       → __matmul__()

REVERSE
────────────────────────────────
+       → __radd__()
-       → __rsub__()
*       → __rmul__()
/       → __rtruediv__()
//      → __rfloordiv__()
%       → __rmod__()
**      → __rpow__()
@       → __rmatmul__()

IN-PLACE
────────────────────────────────
+=      → __iadd__()
-=      → __isub__()
*=      → __imul__()
/=      → __itruediv__()
//=     → __ifloordiv__()
%=      → __imod__()
**=     → __ipow__()
@=      → __imatmul__()

COMPARISON
────────────────────────────────
==      → __eq__()
!=      → __ne__()
<       → __lt__()
<=      → __le__()
>       → __gt__()
>=      → __ge__()

BITWISE
────────────────────────────────
&       → __and__()
|       → __or__()
^       → __xor__()
<<      → __lshift__()
>>      → __rshift__()
~       → __invert__()

REVERSE BITWISE
────────────────────────────────
&       → __rand__()
|       → __ror__()
^       → __rxor__()
<<      → __rlshift__()
>>      → __rrshift__()

IN-PLACE BITWISE
────────────────────────────────
&=      → __iand__()
|=      → __ior__()
^=      → __ixor__()
<<=     → __ilshift__()
>>=     → __irshift__()

UNARY
────────────────────────────────
-a      → __neg__()
+a      → __pos__()
~a      → __invert__()
abs(a)  → __abs__()
